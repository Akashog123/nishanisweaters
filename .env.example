# Nishani Woolera E-commerce Platform - Environment Variables
# Copy this file to .env.local and fill in your values

# ======================
# CLERK AUTHENTICATION
# ======================
# Get these from https://dashboard.clerk.dev
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Webhook secret for Clerk webhooks (optional, for user sync)
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# ======================
# CONVEX BACKEND
# ======================
# Get this from https://dashboard.convex.dev
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Deployment identifier (used by Convex CLI)
CONVEX_DEPLOYMENT=prod:your-deployment-name

# ======================
# RAZORPAY PAYMENTS
# ======================
# Get these from https://dashboard.razorpay.com
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Webhook secret for Razorpay webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ======================
# RESEND EMAIL SERVICE
# ======================
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# ======================
# APP CONFIGURATION
# ======================
VITE_APP_URL=http://localhost:8080
VITE_APP_NAME="Nishani Woolera"

# ======================
# ERROR TRACKING (SENTRY)
# ======================
# Get this from https://sentry.io - Settings > Projects > [Your Project] > Client Keys (DSN)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
