# Load Testing Environment Configuration
# Copy this file to .env.local and fill in your values

# Environment: local, staging, production
TEST_ENV=staging

# Staging Environment URLs
STAGING_FRONTEND_URL=https://staging.your-app.vercel.app
STAGING_CONVEX_API=https://staging-your-app.convex.cloud
STAGING_CONVEX_URL=https://staging-your-app.convex.site

# Production Environment URLs (use with caution)
# PROD_FRONTEND_URL=https://your-app.vercel.app
# PROD_CONVEX_API=https://your-app.convex.cloud
# PROD_CONVEX_URL=https://your-app.convex.site

# Optional: Authenticated testing
# Generate a test user token from Clerk
# TEST_USER_TOKEN=your-test-user-jwt-token

# Optional: k6 Cloud integration
# K6_CLOUD_PROJECT_ID=your-project-id
# K6_CLOUD_TOKEN=your-api-token
