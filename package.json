{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite",
    "dev:backend": "convex dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "convex:deploy": "convex deploy",
    "convex:seed": "convex run seed:seedProducts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:admin": "playwright test e2e/admin.spec.ts",
    "test:e2e:admin:ui": "playwright test e2e/admin.spec.ts --ui",
    "test:e2e:admin:debug": "playwright test e2e/admin.spec.ts --debug",
    "test:e2e:checkout": "playwright test e2e/checkout.spec.ts",
    "test:perf": "playwright test e2e/performance.spec.ts",
    "test:perf:headed": "playwright test e2e/performance.spec.ts --headed",
    "test:load": "npm run test:load:homepage && npm run test:load:products && npm run test:load:cart && npm run test:load:checkout",
    "test:load:smoke": "k6 run tests/load/scripts/homepage.js --vus 3 --duration 30s",
    "test:load:homepage": "k6 run tests/load/scripts/homepage.js",
    "test:load:products": "k6 run tests/load/scripts/products.js",
    "test:load:cart": "k6 run tests/load/scripts/cart.js",
    "test:load:checkout": "k6 run tests/load/scripts/checkout.js",
    "test:load:journey": "k6 run tests/load/scripts/user-journey.js",
    "test:load:peak": "k6 run tests/load/scripts/user-journey.js -e SCENARIO=peak",
    "test:load:stress": "k6 run tests/load/scripts/user-journey.js -e SCENARIO=stress",
    "perf:bundle": "npm run build && node scripts/check-bundle-size.js",
    "perf:lighthouse": "lhci autorun",
    "perf:all": "npm run perf:bundle && npm run test:perf && npm run perf:lighthouse",
    "deploy": "npm run build && npx convex deploy",
    "deploy:frontend": "npm run build",
    "deploy:backend": "npx convex deploy"
